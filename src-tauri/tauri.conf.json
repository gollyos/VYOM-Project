{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYOM",
  "version": "0.2.0",
  "identifier": "ai.vyom.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "VYOM",
        "visible": true,
        "focus": true,
        "center": true,
        "width": 1440,
        "height": 900,
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#06090a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "bundled/python-runtime/": "runtime/python/",
      "bundled/node-runtime/": "runtime/node/",
      "../services/brain/app/": "brain/app/",
      "../services/brain/plugins/": "brain/plugins/",
      "../services/brain/pyproject.toml": "brain/pyproject.toml",
      "../services/brain/.env.example": "brain/.env.example",
      "../services/brain/whatsapp_connector/connector.js": "brain/whatsapp_connector/connector.js",
      "../services/brain/whatsapp_connector/package.json": "brain/whatsapp_connector/package.json",
      "../services/brain/whatsapp_connector/node_modules/": "brain/whatsapp_connector/node_modules/",
      "../config/": "config/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
