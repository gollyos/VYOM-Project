{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYOM",
  "version": "0.2.0",
  "identifier": "ai.vyom.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "VYOM",
        "visible": true,
        "focus": true,
        "center": true,
        "width": 1440,
        "height": 900,
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#06090a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
