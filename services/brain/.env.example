# Brain service only. Never expose these values through Vite or React variables.
VYOM_BRAIN_HOST=127.0.0.1
VYOM_BRAIN_PORT=7788
VYOM_INTEGRATION_CONFIG=../../config/integrations.yaml
VYOM_AUTOMATION_CONFIG=../../config/automations.yaml
# OAuth client configuration is provider-specific and remains disabled until implemented.
# Never place refresh tokens in this file; VYOM stores token bundles through the OS-backed vault.
VYOM_BRAIN_DATABASE=./data/vyom-brain.db
VYOM_PLANNING_COMPLEXITY_THRESHOLD=3
VYOM_MAX_FALLBACKS=2

GEMINI_API_KEY=
GOOGLE_BRAIN_MODEL_ID=

OPENAI_API_KEY=
OPENAI_MODEL_ID=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=

KIMI_API_KEY=
KIMI_MODEL_ID=
