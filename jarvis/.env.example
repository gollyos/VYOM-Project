# JARVIS Desktop Assistant - Configuration Template
# Copy this file to .env and insert your API keys

# Voice & Wake-word
PICOVOICE_ACCESS_KEY=

# LLM Providers (Pick any one for general conversational fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional Information APIs (Open-Meteo and Google News RSS work out-of-the-box without keys)
OPENWEATHERMAP_API_KEY=
NEWS_API_KEY=
